<div class="card">
    <div class="card-header">
        <h6 class="card-title">
            Open Requests
            <a href="{{ getUrl('index.php', true) ~ '&option=hub' }}" title="open requests" class="home_openrequests_link">
                <span class="badge bg-secondary" style="float: right;">{{ number_of_open_requests }}</span>
            </a>
        </h6>
    </div>
    <ul class="list-group list-group-flush">
        {% for value, label in request_type %}
            {% set open_req_value = open_requests[value] ?? "" %}
            <li class="list-group-item">
                <a href="{{ getUrl('index.php', true) ~ '&option=hub&type=' ~ value }}" title="{{ label }}" class="home_openrequests_link">
                    <span class="badge" style="background-color: #337ab7;">{{ open_req_value }}</span>
                </a>
                {{ label }}
            </li>
        {% endfor %}
    </ul>
</div>
