<div class="card">
    <div class="card-header">
        <h6 class="card-title d-flex justify-content-between align-items-center">
            <a class="collapseText d-flex align-items-center w-100 toggle-icon" data-bs-toggle="collapse" href="#collapse_quicklinks" role="button" aria-expanded="true" aria-controls="collapse4">
                Quick Links
                <i class="fa fa-chevron-down ms-auto" aria-hidden="true" id="comment-arrow"></i>
            </a>
        </h6>
    </div>
    {% set collapseOrExpand = settings['home_quicklinks_expand'] == '1' ? 'show' : 'collapse' %}
    <div id="collapse_quicklinks" class="collapse {{ collapseOrExpand }}" aria-expanded="true" style="margin-bottom: 0px; border: 0px;">
        <ul class="list-group">
            {% if homepage %}
                {% set section_order = homepage['links_sectionorder'] %}
                {% if section_order is iterable %}
                    {% set section_order = section_order|sort %}
                {% else %}
                    {% set section_order = homepage['links_sectionhead'] %}
                {% endif %}
                {% for linkid, order in section_order %}
                    <li class="list-group-item quicklink_header">
                        <i class="fa fa-fw {{ homepage_links_sectionorder[homepage['links_sectionicon'][linkid]]|escape }}" aria-hidden="true"></i>
                        {{ homepage['links_sectionhead'][linkid]|escape }}
                    </li>
                    {% for i in 1..number_of_quicklinks %}
                        {% if homepage['links_text' ~ i][linkid] is not empty %}
                            {% set stay = homepage['links_stay' ~ i][linkid] == '1' ? '' : "target='_blank'" %}
                            <li class="list-group-item">
                                <i class="fa fa-fw" aria-hidden="true"></i>
                                <a href="{{ homepage['links_link' ~ i][linkid]|escape }}" {{ stay }}>
                                    {{ homepage['links_text' ~ i][linkid]|escape }}
                                </a>
                            </li>
                        {% endif %}
                    {% endfor %}
                {% endfor %}
            {% else %}
                <li class="list-group-item"><em>No quick links available</em></li>
            {% endif %}
        </ul>
    </div>
</div>
