<div class="card">
    <div class="card-header border-bottom-0">
        <h6 class="card-title d-flex justify-content-between align-items-center">
            My Active Concepts
            <a href="{{ getUrl('index.php', true) ~ '&option=cpt&user' }}">
                View more
            </a>
        </h6>
    </div>
    <div class="table-no-borders">
        <div class="table-responsive">
            <table class="table border-top-0" data-sortable>
                <thead>
                {{ request_header|raw }}
                </thead>
                <tbody>
                {% for concept in my_concepts %}
                    {{ concept.html|raw }}
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>